[chain]
name = "raster-chain-inference"
version = "0.1.0"

# Per-layer auxiliary weights, one committed external per layer. The paths are
# templated; the commitments are not, and are written out positionally — a
# per-index commitment is the one thing here a verifier must read.
[chain.input.aux_layer]
index       = "l"
path        = "prefill-prepare-aux/layer{l}.rastered"
index_path  = "prefill-prepare-aux/layer{l}.rindex"
commitments = [
  "f85c872eeed5f49e3ed0a41fa728f4e9df399fc2eef54c09773862724484a4c8", # l0
  "e7e4703f7e04643c95e9e46180eee472996ca7a71316e59b7ae243525dcd0932", # l1
  "07edeb4e2eff2d116cb4c3b3c9619819458520a6ee829767f71f23a1bb021949", # l2
  "e9f73fab2eb28ea93a5e034b1723437255244ecb0e53075be40052dfda7ab9e8", # l3
  "7cba6bfbad0afb18420aba929f0b8eceae6523a48679e41dd2432e83c4b40752", # l4
  "48c69dc236f2898e675bcd0b521ce2adaff1badd83dbd797e5a1539f19b6524e", # l5
  "3576841a71eea2cc49ca9c1b983d00c2a2c919003b882f721967f87e07219b44", # l6
  "0b4a447a7592af29ac3f9dee30ee13675f7cc51587d23b0c533b90225082db13", # l7
