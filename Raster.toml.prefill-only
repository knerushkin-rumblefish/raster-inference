[[chain.stage]]
name = "prompt_prepare"
project = "prompt-prepare"
inputs.tokenizer = { external = { path = "prompt-prepare/tokenizer.rastered", index_path = "prompt-prepare/tokenizer.rindex", commitment = "aa9b15cfd910f92b91638a8af385aef31f5166466d7871652946f32575812718" } }
inputs.initial_pieces = { external = { path = "prompt-prepare/initial_pieces.rastered", index_path = "prompt-prepare/initial_pieces.rindex", commitment = "7900ddd18ea891084c9c6396e3ea72870d46006967f6e0365f5cab0d8ca4109b" } }

[[chain.stage]]
name = "input_embedding"
project = "input-embedding"
inputs.prompt = { from = "prompt_prepare" }
inputs.embedding = { external = { path = "input-embedding/embedding.rastered", index_path = "input-embedding/embedding.rindex", commitment = "ff2f470ca568b4849bc4e145d9df0e6d933e53f22a3e674178d67bb037ecc41f" } }

[[chain.repeat]]
# The 35 per-layer auxiliary stages. Uniform in everything but the layer file
# they read, so the manifest says that once instead of thirty-five times.
#
# The expansion is `prefill_prepare_aux_l0` .. `_l34`, in order, byte-identical
# to the blocks this replaces — which is the property `chain-repeat`'s
# acceptance test pins. See `docs/proposals/chain-repeat.md` in the raster repo.
name  = "prefill_aux"
index = "l"
count = 35

  [[chain.repeat.stage]]
  name    = "prefill_prepare_aux_l{l}"
  project = "prefill-prepare-aux"
  inputs.embedded = { from = "input_embedding" }
  inputs.layer    = { input = "aux_layer_{l}" }

[[chain.stage]]
name = "prefill_range_l0"
project = "prefill-range"
inputs.activations = { from = "input_embedding" }
inputs.prior_kv = { from = "input_embedding" }
inputs.donor_kv = { from = "input_embedding" }
inputs.ple = { from = "prefill_prepare_aux_l0" }
inputs.layer = { external = { path = "prefill-range/layer0.rastered", index_path = "prefill-range/layer0.rindex", commitment = "f3c302f95356c0a462ab2e1b21ee1d5ec1a8263d4a51fdd4140b4422f066b4ab" } }

[[chain.stage]]
name = "prefill_range_l1"
