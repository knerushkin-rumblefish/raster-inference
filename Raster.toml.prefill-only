[chain]
name = "raster-chain-inference"
version = "0.1.0"

[chain.input.aux_layer]
index = "l"
path = "prefill-prepare-aux/layer{l}.rastered"
index_path = "prefill-prepare-aux/layer{l}.rindex"
commitments = [
  "f571dc53db58afc109dc0d999414271bd36d24b81dff4ac43f35a30142d95e5d", # l0
  "d24e8f7cc7dd1212f7be49e782ef6933239d4ce65df541d35f234b125e8e1f3f", # l1
  "05191fdf9955993b012b4aa7535fedeb1e5a16787fa0a605ee003e6852a385d0", # l2
  "41efa01ac1ef113c4073db95f4d1cc43328ebf422618a984c4836b759594662e", # l3
]

[chain.input.transformer_layer]
index = "l"
path = "prefill-range/layer{l}.rastered"
index_path = "prefill-range/layer{l}.rindex"
commitments = [
  "33c193e7604ec6a47ff0407a62745c34ffa4e8a7b4e6e607b87018af400e57ac", # l0
  "71e99f4419557e892b4e000525acd0351be272db0503e24e7d19be3ae65e7827", # l1
  "ea9fc83a08d5ee73468b3f73657d8f1984e469d996e009aa249a004afdc4d991", # l2
  "44a2960dfa1c98cc555a967d755492ed723bfb75e1c7ec88d5fa7f5c9c1c47cc", # l3
]

[[chain.stage]]
name = "prompt_prepare"
project = "prompt-prepare"
inputs.tokenizer = { external = { path = "prompt-prepare/tokenizer.rastered", index_path = "prompt-prepare/tokenizer.rindex", commitment = "104bec8091bc6d350e06c1697ef24e455a54f72a538e2e76e55f8233ee91fb02" } }
inputs.initial_pieces = { external = { path = "prompt-prepare/initial_pieces.rastered", index_path = "prompt-prepare/initial_pieces.rindex", commitment = "06d581356d7a32bc4fe8b1be3520de2f42096e580c31bf3c421b61c285c6dbc1" } }

[[chain.stage]]
name = "input_embedding"
project = "input-embedding"
inputs.prompt = { from = "prompt_prepare" }
inputs.embedding = { external = { path = "input-embedding/embedding.rastered", index_path = "input-embedding/embedding.rindex", commitment = "e01300e4a6e7bacee9c69aaac1158343530265f6e2ae234c73a2c716d35041e1" } }

[[chain.stage]]
name = "prefill_prepare_aux_l0"
project = "prefill-prepare-aux"
inputs.embedded = { from = "input_embedding" }
inputs.layer = { external = { path = "prefill-prepare-aux/layer0.rastered", index_path = "prefill-prepare-aux/layer0.rindex", commitment = "f571dc53db58afc109dc0d999414271bd36d24b81dff4ac43f35a30142d95e5d" } }

[[chain.stage]]
name = "prefill_prepare_aux_l1"
project = "prefill-prepare-aux"
inputs.embedded = { from = "input_embedding" }
inputs.layer = { external = { path = "prefill-prepare-aux/layer1.rastered", index_path = "prefill-prepare-aux/layer1.rindex", commitment = "d24e8f7cc7dd1212f7be49e782ef6933239d4ce65df541d35f234b125e8e1f3f" } }

[[chain.stage]]
name = "prefill_prepare_aux_l2"
project = "prefill-prepare-aux"
inputs.embedded = { from = "input_embedding" }
inputs.layer = { external = { path = "prefill-prepare-aux/layer2.rastered", index_path = "prefill-prepare-aux/layer2.rindex", commitment = "05191fdf9955993b012b4aa7535fedeb1e5a16787fa0a605ee003e6852a385d0" } }

[[chain.stage]]
name = "prefill_prepare_aux_l3"
project = "prefill-prepare-aux"
inputs.embedded = { from = "input_embedding" }
inputs.layer = { external = { path = "prefill-prepare-aux/layer3.rastered", index_path = "prefill-prepare-aux/layer3.rindex", commitment = "41efa01ac1ef113c4073db95f4d1cc43328ebf422618a984c4836b759594662e" } }

[[chain.stage]]
name = "prefill_range_l0"
project = "prefill-range"
inputs.activations = { from = "input_embedding" }
inputs.prior_kv = { from = "input_embedding" }
inputs.donor_a_kv = { from = "input_embedding" }
inputs.donor_b_kv = { from = "input_embedding" }
inputs.ple = { from = "prefill_prepare_aux_l0" }
inputs.layer = { external = { path = "prefill-range/layer0.rastered", index_path = "prefill-range/layer0.rindex", commitment = "33c193e7604ec6a47ff0407a62745c34ffa4e8a7b4e6e607b87018af400e57ac" } }

[[chain.stage]]
name = "prefill_range_l1"
project = "prefill-range"
inputs.activations = { from = "prefill_range_l0" }
inputs.prior_kv = { from = "input_embedding" }
inputs.donor_a_kv = { from = "input_embedding" }
inputs.donor_b_kv = { from = "input_embedding" }
inputs.ple = { from = "prefill_prepare_aux_l1" }
inputs.layer = { external = { path = "prefill-range/layer1.rastered", index_path = "prefill-range/layer1.rindex", commitment = "71e99f4419557e892b4e000525acd0351be272db0503e24e7d19be3ae65e7827" } }

[[chain.stage]]
name = "prefill_range_l2"
project = "prefill-range"
inputs.activations = { from = "prefill_range_l1" }
inputs.prior_kv = { from = "input_embedding" }
inputs.donor_a_kv = { from = "prefill_range_l0" }
inputs.donor_b_kv = { from = "prefill_range_l1" }
inputs.ple = { from = "prefill_prepare_aux_l2" }
inputs.layer = { external = { path = "prefill-range/layer2.rastered", index_path = "prefill-range/layer2.rindex", commitment = "ea9fc83a08d5ee73468b3f73657d8f1984e469d996e009aa249a004afdc4d991" } }

[[chain.stage]]
name = "prefill_range_l3"
project = "prefill-range"
inputs.activations = { from = "prefill_range_l2" }
inputs.prior_kv = { from = "input_embedding" }
inputs.donor_a_kv = { from = "prefill_range_l0" }
inputs.donor_b_kv = { from = "prefill_range_l1" }
inputs.ple = { from = "prefill_prepare_aux_l3" }
inputs.layer = { external = { path = "prefill-range/layer3.rastered", index_path = "prefill-range/layer3.rindex", commitment = "44a2960dfa1c98cc555a967d755492ed723bfb75e1c7ec88d5fa7f5c9c1c47cc" } }

[[chain.stage]]
name = "prefill_finalize"
project = "prefill-finalize"
inputs.activations = { from = "prefill_range_l3" }
inputs.head = { external = { path = "prefill-finalize/head.rastered", index_path = "prefill-finalize/head.rindex", commitment = "8418a240224235a033b5f2a2a70d40ad78ee1185b1740fc3a0b8300da753d5c4" } }

[[chain.stage]]
name = "decode_init"
project = "decode-init"

[[chain.repeat]]
name = "decode"
index = "t"
count = 0

  [chain.repeat.exports.edge]
stage = "decode_select_t{t}"
entry = "decode_init"

  [chain.repeat.exports.logits]
stage = "decode_finalize_t{t}"
entry = "prefill_finalize"

  [[chain.repeat.stage]]
name = "decode_select_t{t}"
project = "decode-select-token"
inputs.logits = { from = "decode_finalize_t{t-1}", first = "prefill_finalize" }
inputs.prior = { from = "decode_select_t{t-1}", first = "decode_init" }

  [[chain.repeat.stage]]
name = "decode_embed_t{t}"
project = "decode-embed"
inputs.selected = { from = "decode_select_t{t}" }
  inputs.embedding = { external = { path = "input-embedding/embedding.rastered", index_path = "input-embedding/embedding.rindex", commitment = "e01300e4a6e7bacee9c69aaac1158343530265f6e2ae234c73a2c716d35041e1" } }

  [[chain.repeat.stage]]
name = "decode_aux_t{t}_l{l}"
index = "l"
count = 4
project = "prefill-prepare-aux"
inputs.embedded = { from = "decode_embed_t{t}" }
inputs.layer = { input = "aux_layer_{l}" }

  [[chain.repeat.stage]]
name = "decode_range_t{t}_l{l}"
index = "l"
start = 0
count = 2
project = "prefill-range"
inputs.activations = { from = "decode_range_t{t}_l{l-1}", first = "decode_embed_t{t}" }
inputs.prior_kv = { from = "decode_range_t{t-1}_l{l}", first = "prefill_range_l{l}" }
inputs.donor_a_kv = { from = "input_embedding" }
inputs.donor_b_kv = { from = "input_embedding" }
inputs.ple = { from = "decode_aux_t{t}_l{l}" }
inputs.layer = { input = "transformer_layer_{l}" }

  [[chain.repeat.stage]]
name = "decode_range_t{t}_l{l}"
index = "l"
start = 2
count = 2
project = "prefill-range"
inputs.activations = { from = "decode_range_t{t}_l{l-1}", first = "decode_range_t{t}_l1" }
inputs.prior_kv = { from = "decode_range_t{t-1}_l{l}", first = "prefill_range_l{l}" }
inputs.donor_a_kv = { from = "decode_range_t{t}_l0" }
inputs.donor_b_kv = { from = "decode_range_t{t}_l1" }
inputs.ple = { from = "decode_aux_t{t}_l{l}" }
inputs.layer = { input = "transformer_layer_{l}" }

  [[chain.repeat.stage]]
name = "decode_finalize_t{t}"
project = "prefill-finalize"
inputs.activations = { from = "decode_range_t{t}_l3" }
inputs.head = { external = { path = "prefill-finalize/head.rastered", index_path = "prefill-finalize/head.rindex", commitment = "8418a240224235a033b5f2a2a70d40ad78ee1185b1740fc3a0b8300da753d5c4" } }

[[chain.stage]]
name = "output_finalize"
project = "output-finalize"
inputs.edge = { from = "decode.edge" }
inputs.decoder = { external = { path = "output-finalize/decoder.rastered", index_path = "output-finalize/decoder.rindex", commitment = "9a70ea856b8c08d137dc87ad073e24527fa4ce4db574fd84b616c20b2a22cf3d" } }
